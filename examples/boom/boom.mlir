    %7 = comb.extract %tail from 5 : (i8) -> i3
    %8 = comb.extract %tail from 0 : (i8) -> i5
    %9 = comb.concat %8, %7 {sv.namehint = "_might_hit_head_T_35"} : i5, i3
    %10 = comb.and bin %head, %3 {sv.namehint = "_might_hit_head_T_36"} : i8
    %11 = comb.and bin %head, %6 {sv.namehint = "_might_hit_head_T_37"} : i8
    %12 = comb.and bin %head, %9 {sv.namehint = "_might_hit_head_T_38"} : i8
    %13 = comb.or bin %10, %11, %12 {sv.namehint = "_might_hit_head_T_40"} : i8
    %14 = comb.and bin %tail, %head {sv.namehint = "_at_head_T_9"} : i8
    %15 = comb.icmp bin ne %14, %c0_i8 {sv.namehint = "at_head"} : i8
    %16 = comb.and bin %15, %maybe_full {sv.namehint = "_do_enq_T"} : i1
    %17 = comb.concat %16, %13 : i1, i8
    %18 = comb.icmp bin eq %17, %c0_i9 {sv.namehint = "do_enq"} : i9
    %19 = comb.extract %io_enq_bits_pc from 3 : (i40) -> i37
    %20 = comb.concat %19, %c0_i3 {sv.namehint = "pc"} : i37, i3
