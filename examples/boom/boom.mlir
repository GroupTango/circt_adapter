  hw.module private @BranchMaskGenerationLogic(in %clock : !seq.clock, in %reset : i1, in %io_is_branch_0 : i1, in %io_will_fire_0 : i1, out io_br_tag_0 : i3, out io_br_mask_0 : i8, out io_is_full_0 : i1, in %io_brupdate_b1_resolve_mask : i8, in %io_brupdate_b2_uop_br_mask : i8, in %io_brupdate_b2_mispredict : i1, in %io_flush_pipeline : i1) {
    %c0_i7 = hw.constant 0 : i7
