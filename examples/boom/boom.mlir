    %head = seq.firreg %665 clock %clock reset sync %reset, %c1_i8 {firrtl.random_init_start = 3112 : ui64} : i8
    %tail = seq.firreg %666 clock %clock reset sync %reset, %c1_i8 {firrtl.random_init_start = 3120 : ui64, sv.namehint = "tail"} : i8
