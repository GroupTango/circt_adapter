    %0 = comb.extract %tail from 0 {sv.namehint = "_might_hit_head_T"} : (i8) -> i7
    %1 = comb.extract %tail from 7 {sv.namehint = "_at_head_T_7"} : (i8) -> i1
    %2 = comb.extract %tail from 0 : (i8) -> i7
    %3 = comb.concat %2, %1 {sv.namehint = "_might_hit_head_T_11"} : i7, i1
